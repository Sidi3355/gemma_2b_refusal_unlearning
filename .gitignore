__pycache__/
*.pyc
.venv/

# Ignore generated results, keep the small shareable artefacts:
results/*
!results/.gitkeep
!results/summary.md
!results/responses.csv
!results/all_conditions_*.json
!results/baked_mean_*.json
# the tiny control-vector file is committable; large *.gguf model files are not
!results/gguf/
results/gguf/*
!results/gguf/*.controlvector.gguf
